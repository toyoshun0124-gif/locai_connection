// データベースの設計図（どんな表があり、どんな項目を持つか）

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 役割：購入者（お店など）か、生産者（農家さん）か
enum Role {
  BUYER
  PRODUCER
}

// 購入者の区分：飲食店か、一般消費者か（生産者は空のまま）
enum BuyerType {
  RESTAURANT
  CONSUMER
}

// 関西の2府4県だけ選べる（5章「別人」：関西限定）
enum Prefecture {
  OSAKA
  KYOTO
  HYOGO
  NARA
  SHIGA
  WAKAYAMA
}

// プロフィール（登録はスキップできる。マイページからいつでも登録・修正できる）
model Profile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  city      String? // 市町村（例：南丹市）。公開する
  shopKind  String? // お店の種類（例：小料理屋）。購入者だけ。公開する
  items     String? // 取り扱い食材（例：賀茂茄子）。生産者だけ。公開する
  policy    String? // 方針・こだわり。公開する
  address   String? // 住所。売買が決まった相手にだけ見せる（ほかの人には絶対に見せない）
  updatedAt DateTime @updatedAt

  @@map("profile")
}

// 出品の状態：公開中（申し込める）／終了（坂田さんが終わりにした）
enum ListingStatus {
  OPEN
  CLOSED
}

// 出品（坂田さんが売りたい野菜）。量は g、金額は円の整数で持つ（小数で計算しない）
model Listing {
  id              String        @id @default(cuid())
  producerId      String
  producer        User          @relation(fields: [producerId], references: [id], onDelete: Cascade)
  name            String // 商品名（例：賀茂茄子）
  city            String // 産地の市町村（府県は登録時のものを使う）
  pricePerKg      Int // 1kgあたりの値段（円）
  quantityG       Int // 出品した量（g）
  minOrderG       Int // いちばん少ない注文量（g）
  unitG           Int // 注文の単位（g）
  delivery        Boolean // 坂田さんが届けられる
  pickup          Boolean // お店が取りに来られる
  shippingYen     Int // 送料（円）。届けるときだけ使う
  replyDays       Int // 回答期限：申し込みから何日以内に返事するか（1〜3）
  shipDates       DateTime[]    @db.Date // 出荷できる日（1日以上）
  status          ListingStatus @default(OPEN)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([producerId, createdAt])
  @@index([status, name])
  @@map("listing")
}

// ===== ここから下は、ログインの仕組み（Better Auth）が使う表 =====

model User {
  id            String      @id
  name          String // ニックネーム（本名は使わない）
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  role          Role
  buyerType     BuyerType?
  prefecture    Prefecture
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  profile       Profile?
  listings      Listing[]

  @@map("user")
}

// ログイン中であることの記録
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// ログイン方法（メールとパスワードなど）。パスワードは暗号化して保存される
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// 確認用の一時的な記録（メール確認などで使う）
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
