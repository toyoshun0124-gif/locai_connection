# 環境変数の「見本」ファイル（GitHub に送ってよい）
# 本物の値はここに書かない。.env.local にコピーしてから値を入れる。

# Neon のプーリング経由の接続文字列（アプリの実行時に使う）
DATABASE_URL=

# Neon の直接接続の接続文字列（Prisma のマイグレーションで使う）
DATABASE_URL_UNPOOLED=

# Google AI Studio で作った API キー（サーバー側だけで使う）
GEMINI_API_KEY=

# AI Studio で確認したモデル名
GEMINI_MODEL=

# Better Auth（ログインの仕組み）用。名前は導入時に公式ドキュメントで確認する
# ログイン情報を守るための秘密の文字列
BETTER_AUTH_SECRET=
# アプリのアドレス（ローカルでは http://localhost:3000）
BETTER_AUTH_URL=
